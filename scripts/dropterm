#!/usr/bin/env bash
# Drop-down terminal for niri. Bound in ~/.config/niri/dropterm.kdl.
#
# Toggle: opens it as a centered floating window, brings it to the focused
# workspace and monitor if it is open elsewhere, or closes it if it is focused.
# It runs with DROPTERM=1, which makes zsh attach to the tmux session "General"
# (see .zshrc), so closing it only detaches tmux.
set -euo pipefail

# A separate class makes this its own Ghostty instance, apart from the main one
APP_ID=com.mitchellh.ghostty.dropterm

win=$(niri msg -j windows | jq -c --arg id "$APP_ID" 'first(.[] | select(.app_id == $id)) // empty')

if [[ -z $win ]]; then
  exec ghostty --class="$APP_ID" --env=DROPTERM=1
fi

win_id=$(jq -r '.id' <<<"$win")

if [[ $(jq -r '.is_focused' <<<"$win") == true ]]; then
  niri msg action close-window --id "$win_id"
  exit 0
fi

workspaces=$(niri msg -j workspaces)
focused=$(jq -c 'first(.[] | select(.is_focused))' <<<"$workspaces")
win_output=$(jq -r --argjson ws "$(jq -r '.workspace_id' <<<"$win")" \
  'first(.[] | select(.id == $ws)) | .output' <<<"$workspaces")
target_output=$(jq -r '.output' <<<"$focused")

if [[ $win_output != "$target_output" ]]; then
  # Lands on that output's active workspace, which is the focused one
  niri msg action move-window-to-monitor --id "$win_id" "$target_output"
else
  niri msg action move-window-to-workspace --window-id "$win_id" --focus false "$(jq -r '.idx' <<<"$focused")"
fi
niri msg action focus-window --id "$win_id"
niri msg action center-window --id "$win_id"
