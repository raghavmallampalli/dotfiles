// Drop-down terminal, toggled by ~/.local/scripts/dropterm.
// It floats centered on screen; toggling it off closes the window.

window-rule {
    match app-id=r#"^com\.mitchellh\.ghostty\.dropterm$"#

    open-floating true
    default-column-width { proportion 0.7; }
    default-window-height { proportion 0.7; }
}

binds {
    Mod+Grave hotkey-overlay-title="Drop-down Terminal" { spawn "~/.local/scripts/dropterm"; }
}
